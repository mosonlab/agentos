  "cards": [
    {
      "dot": "cyan",
      "title": "Control plane",
      "items": [
        "Hono API over Prisma/PostgreSQL",
        "Exactly one API owns the canonical workspace root",
        "Task state is stored apart from durable Run and SessionEvent records"
      ]
    },
    {
      "dot": "emerald",
      "title": "Run execution",
      "items": [
        "Runners claim work with a fenced lease and poll one API",
        "Each Run gets a throwaway clone on its own run branch",
        "Provider processes receive an explicit environment, not the host's"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Operator, runner, and per-run session principals are separate",
        "Stale fencing generations are rejected and the process group terminated",
        "Grants are an authorization and audit boundary, not an OS sandbox"
      ]
    }
  ]
