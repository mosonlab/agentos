# PostgreSQL started by docker-compose.yml
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos?schema=public

# Control-plane API. These principals must be distinct random values.
API_HOST=0.0.0.0
API_PORT=3000
OPERATOR_TOKEN=CHANGE_ME
RUNNER_TOKEN=CHANGE_ME
SESSION_COOKIE_SECRET=CHANGE_ME
# 32 random bytes encoded as base64; stays outside the database and runner env.
AGENTOS_SECRET_ENCRYPTION_KEY=CHANGE_ME

# Browser console: operator principal only.
VITE_API_URL=http://localhost:3000
VITE_API_TOKEN=CHANGE_ME

# Local runner process: runner principal only.
RUNNER_API_URL=http://localhost:3000
RUNNER_POLL_INTERVAL_MS=5000
RUNNER_LEASE_SECONDS=60
RUNNER_HEARTBEAT_INTERVAL_MS=30000
RUNNER_ID=

# Explicit child-process environment and controlled ephemeral workspaces.
RUNNER_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
RUNNER_HOME=/Users/agentrunner
# Default: the runner process owner's ~/.agentos/runs. Values are not shell-expanded,
# so an override must be an absolute path (for example: /opt/agentos/runs).
# RUNNER_WORKSPACE_ROOT=/opt/agentos/runs
# API-only ownership state. This must be a disjoint local filesystem directory,
# mode 0700, owned by the API uid, and unreadable/unwritable by runner/model uids.
# CONTROL_PLANE_STATE_DIR=/opt/agentos/control-plane
RUNNER_FAILED_WORKSPACE_RETENTION=2
RUNNER_TOOL_DEADLINE_MS=600000

# Optional low-privilege launch prefix. Leave empty unless the account exists,
# can traverse RUNNER_WORKSPACE_ROOT, and all three CLIs are logged in for that account.
# The default workspace root is still resolved under the runner process owner's home;
# point it elsewhere or grant the launched account traversal explicitly. No ACLs are managed.
# While this prefix is empty, model CLIs run as the runner's OS user and FilesystemGrant
# is an audit/ergonomics boundary, not a security boundary.
RUNNER_RUN_AS_PREFIX=
# Example after those prerequisites: sudo -u agentrunner

CLAUDE_BINARY=claude
CODEX_BINARY=codex
PI_BINARY=pi

# Feishu Inbox long connection. Keep the service resident: missed events are not replayed.
FEISHU_APP_ID=
FEISHU_APP_SECRET=CHANGE_ME
FEISHU_DEFAULT_CHAT_ID=
INBOX_DELIVERY_POLL_MS=2000
# Set to 0 to disable CRON/AT polling without changing API behavior.
SCHEDULER_POLL_INTERVAL_MS=30000

# Files Root defaults to the API process owner's ~/Documents/agentos. Values are not
# shell-expanded, so overrides must be absolute (for example: /opt/agentos/files).
# FILES_ROOT=/opt/agentos/files
# With iCloud Desktop & Documents sync, files can become dataless placeholders: reads
# may fail and agent writes may be uploaded. The API warns at startup but still starts.
# FilesystemGrant becomes a security boundary only when the model CLI runs as a separate
# principal that cannot traverse or write FILES_ROOT; otherwise it is an audit boundary.
# FILES_ROOT must not overlap RUNNER_WORKSPACE_ROOT in either direction: agents can write
# anywhere in a run workspace, and write access inside the Files Root is the precondition
# for the post-walk directory swap the store cannot close. The API refuses to start on
# overlap, and warns while RUNNER_RUN_AS_PREFIX is empty (the shipped default), because
# that is exactly the configuration in which the backstop for that gap is absent.

# Run budget defaults (spendCap is stored but not applicable to subscription CLIs)
SESSION_MAX_DURATION_MIN=120
STALL_TIMEOUT_MIN=10
MAX_SESSIONS_PER_TASK=3
