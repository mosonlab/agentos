# PostgreSQL started by docker-compose.yml
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos?schema=public

# Control-plane API
API_HOST=0.0.0.0
API_PORT=3000
# One shared bearer token used by the operator UI and local runner.
AGENTOS_API_TOKEN=replace-with-a-long-random-token
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Browser console
VITE_API_URL=http://localhost:3000
# Optional convenience for a trusted local build. If omitted, the UI asks once.
VITE_API_TOKEN=

# Local runner process.
RUNNER_API_URL=http://localhost:3000
RUNNER_POLL_INTERVAL_MS=5000
RUNNER_LEASE_SECONDS=60
RUNNER_ID=

# Trusted local shell command templates. The task prompt is sent on stdin.
CLAUDE_COMMAND_TEMPLATE=claude --dangerously-skip-permissions --print
CODEX_COMMAND_TEMPLATE=codex exec --dangerously-bypass-approvals-and-sandbox -
PI_COMMAND_TEMPLATE=pi

# Local persistent filesystem (DECISIONS #8; no object storage)
AGENTOS_FILES_ROOT=./var/files

# Runtime guardrail defaults (DECISIONS #12)
SESSION_MAX_DURATION_MIN=120
STALL_TIMEOUT_MIN=10
MAX_SESSIONS_PER_TASK=3
