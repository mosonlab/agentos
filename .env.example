# PostgreSQL started by docker-compose.yml
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos?schema=public

# Control-plane API
API_HOST=0.0.0.0
API_PORT=3000
OPERATOR_TOKEN=replace-with-a-long-random-token
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Browser console
VITE_API_URL=http://localhost:3000

# Local runner process. Phase 0 only polls; execution arrives in Phase 1.
RUNNER_API_URL=http://localhost:3000
RUNNER_TOKEN=replace-with-a-runner-token
RUNNER_POLL_INTERVAL_MS=5000

# Local persistent filesystem (DECISIONS #8; no object storage)
AGENTOS_FILES_ROOT=./var/files

# Runtime guardrail defaults (DECISIONS #12)
SESSION_MAX_DURATION_MIN=120
STALL_TIMEOUT_MIN=10
MAX_SESSIONS_PER_TASK=3

