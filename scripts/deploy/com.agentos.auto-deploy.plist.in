<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentos.auto-deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BINARY__</string>
    <string>__DEPLOY_SCRIPT__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPOSITORY_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENTOS_REPOSITORY_ROOT</key>
    <string>__REPOSITORY_ROOT__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>QUIET_WINDOW_POLL_SECONDS</key>
    <string>60</string>
    <key>DEPLOY_NODE_BINARY</key>
    <string>__NODE_BINARY__</string>
    <key>DEPLOY_GIT_BINARY</key>
    <string>__GIT_BINARY__</string>
    <key>DEPLOY_NPM_BINARY</key>
    <string>__NPM_BINARY__</string>
    <key>DEPLOY_SOURCE_REMOTE</key>
    <string>__SOURCE_REMOTE__</string>
__DEPLOY_ROLE_ENVIRONMENT__
__BACKUP_ENVIRONMENT__
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__STDOUT_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__STDERR_PATH__</string>
</dict>
</plist>
