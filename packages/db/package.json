{
  "name": "@agentos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test prisma/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:drift-check": "node scripts/check-drift.mjs",
    "db:files-precheck": "dotenv -e ../../.env -- tsx prisma/precheck-files.ts",
    "db:backfill-session-usage": "dotenv -e ../../.env -- tsx prisma/backfill-session-usage.ts",
    "db:backfill-task-source": "dotenv -e ../../.env -- tsx prisma/backfill-task-source.ts",
    "db:verify-agent-template": "dotenv -e ../../.env -- tsx prisma/verify-agent-template.ts",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:fixture": "dotenv -e ../../.env -- tsx prisma/acceptance-fixture.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.6"
  }
}
