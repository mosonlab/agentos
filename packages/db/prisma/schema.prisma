generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NetworkingMode {
  OPEN    @map("open")
  LIMITED @map("limited")
}

enum SkillKind {
  PROMPT @map("prompt")
  FILE   @map("file")
}

enum RepoPermission {
  GIT_READ  @map("git-read")
  GIT_WRITE @map("git-write")
}

enum SecretPurpose {
  MCP     @map("mcp")
  REPO    @map("repo")
  ENV     @map("env")
  WEBHOOK @map("webhook")
}

enum RunnerKind {
  CLAUDE @map("claude")
  CODEX  @map("codex")
  PI     @map("pi")
}

enum RunnerPreference {
  CLAUDE  @map("claude")
  CODEX   @map("codex")
  PI      @map("pi")
  AUTO    @map("auto")
  INHERIT @map("inherit")
}

enum TaskStatus {
  // BACKLOG is first so the datamodel's value order matches the database's:
  // its migration adds the value with `BEFORE 'todo'`.
  BACKLOG @map("backlog")
  TODO    @map("todo")
  DOING   @map("doing")
  REVIEW  @map("review")
  DONE    @map("done")
}

/// How a Task came to exist. The recurring definition itself stays MANUAL;
/// only its fired copies are CRON.
enum TaskSource {
  MANUAL  @map("manual")
  CRON    @map("cron")
  WEBHOOK @map("webhook")
}

enum TriggerFireSource {
  WEBHOOK @map("webhook")
  MANUAL  @map("manual")
}

enum AssigneeType {
  AGENT @map("agent")
  HUMAN @map("human")
}

enum ScheduleKind {
  NOW  @map("once-now")
  AT   @map("at")
  CRON @map("cron")
}

enum GoalStatus {
  ACTIVE        @map("active")
  PAUSED        @map("paused")
  COMPLETED     @map("completed")
  STOPPED_SPEND @map("stopped-spend")
  STOPPED_TIME  @map("stopped-time")
  STOPPED_STUCK @map("stopped-stuck")
  FAILED        @map("failed")
  CANCELLED     @map("cancelled")
}

/// Dispatch state of one Goal iteration's Task. `MIGRATED_CLOSED` is only ever
/// written by the Goal 5a0 backfill for pre-kernel history; runtime code never
/// writes it.
enum GoalDispatchState {
  EXECUTING         @map("executing")
  AWAITING_DECISION @map("awaiting-decision")
  ADVANCED          @map("advanced")
  GOAL_COMPLETED    @map("goal-completed")
  GOAL_FAILED       @map("goal-failed")
  CANCELLED         @map("cancelled")
  MIGRATED_CLOSED   @map("migrated-closed")
}

enum InboxSender {
  AGENT @map("agent")
  HUMAN @map("human")
}

enum InboxKind {
  TEXT            @map("text")
  MULTIPLE_CHOICE @map("multiple-choice")
}

enum InboxStatus {
  OPEN     @map("open")
  ANSWERED @map("answered")
  CLOSED   @map("closed")
}

enum InboxChannel {
  FEISHU @map("feishu")
}

enum InboxDeliveryStatus {
  PENDING   @map("pending")
  SENDING   @map("sending")
  DELIVERED @map("delivered")
  FAILED    @map("failed")
}

enum RunStatus {
  QUEUED        @map("queued")
  CLAIMED       @map("claimed")
  PROVISIONING  @map("provisioning")
  RUNNING       @map("running")
  WAITING_INBOX @map("waiting-inbox")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
  TIMED_OUT     @map("timed-out")
  CANCELLED     @map("cancelled")
  LOST          @map("lost")
}

enum SessionExecutionStatus {
  REQUESTED     @map("requested")
  PROVISIONING  @map("provisioning")
  RUNNING       @map("running")
  WAITING_INBOX @map("waiting-inbox")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
  TIMED_OUT     @map("timed-out")
  CANCELLED     @map("cancelled")
  LOST          @map("lost")
}

enum CleanupStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  RETAINED  @map("retained")
}

enum FailureClass {
  BINARY_NOT_FOUND       @map("binary-not-found")
  AUTH_REQUIRED          @map("auth-required")
  RATE_LIMITED           @map("rate-limited")
  CANCELLED_OR_TIMED_OUT @map("cancelled-or-timed-out")
  TOOL_FAILED            @map("tool-failed")
  TRANSIENT_PROVIDER     @map("transient-provider")
  PROTOCOL_ERROR         @map("protocol-error")
  TASK_FAILED            @map("task-failed")
  BUDGET_EXCEEDED        @map("budget-exceeded")
}

enum SessionEventSource {
  RUNNER @map("runner")
  CLAUDE @map("claude")
  CODEX  @map("codex")
  PI     @map("pi")
}

enum PushStatus {
  NOT_REQUESTED @map("not-requested")
  PENDING       @map("pending")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
}

model Project {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  yamlDocument       String          @default("")
  maxDurationMin     Int             @default(240)
  stallTimeoutMin    Int             @default(10)
  maxSessionsPerTask Int             @default(3)
  spendCap           Decimal?        @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  agents             Agent[]
  environments       Environment[]
  skills             Skill[]
  mcpConnections     MCPConnection[]
  repos              Repo[]
  taskTemplates      TaskTemplate[]
  tasks              Task[]
  goals              Goal[]
  runs               Run[]
}

model Environment {
  id           String              @id @default(cuid())
  projectId    String
  name         String
  networking   NetworkingMode      @default(LIMITED)
  allowedHosts String[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agents       Agent[]
  secrets      EnvironmentSecret[]

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
}

model Agent {
  id                 String               @id @default(cuid())
  projectId          String
  environmentId      String
  name               String
  title              String
  model              String
  foundationalPrompt String
  rolePrompt         String
  runnerPreference   RunnerPreference     @default(INHERIT)
  inboxAccess        Boolean              @default(false)
  /// Denied tools, not allowed ones: empty means "every tool the CLI offers",
  /// which is what every agent had before this column existed. Keys are the eight
  /// canonical names in apps/web/src/lib/tools.ts; the runner maps them per CLI in
  /// packages/runner/src/adapters.ts.
  disabledTools      String[]             @default([])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  archivedAt         DateTime?
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment        Environment          @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Restrict)
  skills             AgentSkill[]
  mcpConnections     AgentMCPConnection[]
  repoAccess         AgentRepoAccess[]
  filesystemGrants   FilesystemGrant[]
  collaborators      AgentCollaboration[] @relation("AgentCollaborators")
  collaboratorFor    AgentCollaboration[] @relation("AllowedCollaborator")
  secretGrants       AgentSecretGrant[]
  assignedTasks      Task[]
  templateSteps      TaskTemplateStep[]
  sessions           Session[]
  runs               Run[]
  inboxMessages      InboxMessage[]

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
  @@index([environmentId])
}

model Skill {
  id        String       @id @default(cuid())
  projectId String
  name      String
  slug      String
  kind      SkillKind
  body      String?
  filePath  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agents    AgentSkill[]

  @@unique([projectId, slug])
  @@unique([id, projectId])
  @@index([projectId])
}

model AgentSkill {
  agentId   String
  skillId   String
  projectId String
  agent     Agent  @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  skill     Skill  @relation(fields: [skillId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, skillId])
  @@index([skillId])
}

model MCPConnection {
  id                 String               @id @default(cuid())
  projectId          String
  credentialSecretId String?
  name               String
  transport          String
  config             Json
  allowedOperations  String[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentialSecret   Secret?              @relation("McpCredential", fields: [credentialSecretId], references: [id], onDelete: SetNull)
  agents             AgentMCPConnection[]

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
  @@index([credentialSecretId])
}

model AgentMCPConnection {
  agentId         String
  mcpConnectionId String
  projectId       String
  agent           Agent         @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  mcpConnection   MCPConnection @relation(fields: [mcpConnectionId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, mcpConnectionId])
  @@index([mcpConnectionId])
}

model Repo {
  id                 String            @id @default(cuid())
  projectId          String
  credentialSecretId String?
  name               String
  remoteUrl          String
  mountPath          String
  defaultBranch      String            @default("main")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentialSecret   Secret?           @relation("RepoCredential", fields: [credentialSecretId], references: [id], onDelete: SetNull)
  agentAccess        AgentRepoAccess[]
  tasks              Task[]
  runs               Run[]
  webhookTemplates   TaskTemplate[]    @relation("WebhookRepo")

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
  @@index([credentialSecretId])
}

model AgentRepoAccess {
  agentId     String
  repoId      String
  projectId   String
  mountPath   String
  permissions RepoPermission
  agent       Agent          @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  repo        Repo           @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, repoId])
  @@index([repoId])
}

// folderPath is a canonical Files-Root-relative POSIX path; "" grants the whole Files Root.
model FilesystemGrant {
  id         String  @id @default(cuid())
  agentId    String
  folderPath String
  canRead    Boolean @default(false)
  canWrite   Boolean @default(false)
  canDelete  Boolean @default(false)
  agent      Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, folderPath])
  @@index([agentId])
}

model AgentCollaboration {
  agentId        String
  allowedAgentId String
  projectId      String
  agent          Agent  @relation("AgentCollaborators", fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  allowedAgent   Agent  @relation("AllowedCollaborator", fields: [allowedAgentId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, allowedAgentId])
  @@index([allowedAgentId])
}

model Secret {
  id                String              @id @default(cuid())
  name              String              @unique
  encryptedValue    String
  purpose           SecretPurpose
  description       String?
  ciphertextVersion Int                 @default(1)
  keyId             String              @default("v1")
  rotatedAt         DateTime?
  disabledAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  mcpCredentials    MCPConnection[]     @relation("McpCredential")
  repoCredentials   Repo[]              @relation("RepoCredential")
  webhookTemplates  TaskTemplate[]      @relation("WebhookCredential")
  agentGrants       AgentSecretGrant[]
  environments      EnvironmentSecret[]
}

model AgentSecretGrant {
  agentId  String
  secretId String
  envVar   String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  secret   Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@id([agentId, secretId, envVar])
  @@unique([agentId, envVar])
  @@index([secretId])
}

model EnvironmentSecret {
  environmentId String
  secretId      String
  envVar        String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  secret        Secret      @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@id([environmentId, secretId, envVar])
  @@unique([environmentId, envVar])
  @@index([secretId])
}

model TaskTemplate {
  id                     String             @id @default(cuid())
  projectId              String
  name                   String
  description            String
  variables              String[]
  webhookSecretId        String?
  webhookRepoId          String?
  webhookPayloadMapping  Json?
  webhookPausedAt        DateTime?
  webhookReplayWindowSec Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  project                Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  webhookSecret          Secret?            @relation("WebhookCredential", fields: [webhookSecretId], references: [id], onDelete: SetNull)
  webhookRepo            Repo?              @relation("WebhookRepo", fields: [webhookRepoId], references: [id], onDelete: Restrict)
  steps                  TaskTemplateStep[]
  tasks                  Task[]
  fires                  TriggerFire[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([webhookSecretId])
  @@index([webhookRepoId])
}

model TaskTemplateStep {
  id                      String       @id @default(cuid())
  taskTemplateId          String
  assigneeAgentId         String?
  stepIndex               Int
  name                    String
  assigneeType            AssigneeType
  prompt                  String
  approvalGate            Boolean      @default(false)
  attachmentsFromPrevious Boolean      @default(false)
  spawnPolicy             Json?
  runner                  RunnerKind?
  outputKind              String       @default("result")
  opensPullRequest        Boolean      @default(true)
  baseFromStepIndex       Int?
  taskTemplate            TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  assigneeAgent           Agent?       @relation(fields: [assigneeAgentId], references: [id], onDelete: SetNull)
  tasks                   Task[]

  @@unique([taskTemplateId, stepIndex])
  @@index([assigneeAgentId])
}

model Task {
  id                      String               @id @default(cuid())
  projectId               String
  assigneeAgentId         String?
  repoId                  String?
  templateId              String?
  templateStepId          String?
  followUpTaskId          String?              @unique
  name                    String
  description             String
  workingDirectory        String?
  targetBranch            String?
  failureReason           String?
  status                  TaskStatus           @default(TODO)
  source                  TaskSource           @default(MANUAL)
  archivedAt              DateTime?
  schedulePausedAt        DateTime?
  recurringSourceTaskId   String?
  assigneeType            AssigneeType         @default(AGENT)
  approvalGate            Boolean              @default(false)
  /// Whether a run of this task may open a pull request. Copied onto each Run at
  /// creation so a PATCH cannot change a run that is already queued.
  opensPullRequest        Boolean              @default(true)
  chainId                 String?
  chainIndex              Int?
  scheduleKind            ScheduleKind         @default(NOW)
  runAt                   DateTime?
  cron                    String?
  timezone                String?
  maxDurationMin          Int                  @default(240)
  stallTimeoutMin         Int                  @default(10)
  maxSessionsPerTask      Int                  @default(5)
  spendCap                Decimal?             @db.Decimal(12, 2)
  spendCapApplicable      Boolean              @default(false)
  /// Goal 5a0 lineage. All eleven columns are all-null on a manual/chain/template/
  /// CRON/AT Task and all-non-null-where-required on a Goal-linked Task; the
  /// database checks installed by 20260818000000_goal_execution_safety_kernel are
  /// the backstop, and only the Goal safety kernel writes them.
  goalId                  String?
  goalGeneration          Int?
  goalIteration           Int?
  goalDispatchKey         String?
  goalDispatchRequestHash String?
  goalDispatchState       GoalDispatchState?
  goalDecisionKey         String?
  goalDecisionRequestHash String?
  goalDecisionRunId       String?
  goalDecisionAt          DateTime?
  goalPredecessorTaskId   String?              @unique
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  project                 Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeAgent           Agent?               @relation(fields: [assigneeAgentId, projectId], references: [id, projectId], onDelete: Restrict)
  repo                    Repo?                @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Restrict)
  template                TaskTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateStep            TaskTemplateStep?    @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  followUpTask            Task?                @relation("TaskFollowUp", fields: [followUpTaskId], references: [id], onDelete: SetNull)
  previousTask            Task?                @relation("TaskFollowUp")
  recurringSource         Task?                @relation("TaskRecurringSource", fields: [recurringSourceTaskId], references: [id], onDelete: SetNull)
  recurringCopies         Task[]               @relation("TaskRecurringSource")
  activity                TaskActivity[]
  sessions                Session[]
  runs                    Run[]
  inboxMessages           InboxMessage[]
  gateMessages            InboxMessage[]       @relation("InboxGateTask")
  inboxThreads            InboxThread[]
  stepOutput              TaskStepOutput?
  goal                    Goal?                @relation(fields: [goalId, projectId], references: [id, projectId], onDelete: Restrict)
  goalDecisionRun         Run?                 @relation("TaskGoalDecisionRun", fields: [goalDecisionRunId], references: [id], onDelete: Restrict)
  goalPredecessorTask     Task?                @relation("TaskGoalPredecessor", fields: [goalPredecessorTaskId], references: [id], onDelete: Restrict)
  goalSuccessorTask       Task?                @relation("TaskGoalPredecessor")
  /// Step 2.7 identity backstops. The single-column relations stay as the
  /// delete restrictions the spec names; these composite ones are what stop a
  /// predecessor, Run, or event from crossing a Goal, generation, or iteration.
  goalPredecessorIdentity Task?                @relation("TaskGoalPredecessorIdentity", fields: [goalPredecessorTaskId, goalId, goalGeneration], references: [id, goalId, goalGeneration], onDelete: Restrict)
  goalSuccessorIdentities Task[]               @relation("TaskGoalPredecessorIdentity")
  goalLineageRuns         Run[]                @relation("RunGoalLineageIdentity")
  goalEventIdentities     GoalExecutionEvent[] @relation("GoalEventTaskIdentity")
  goalExecutionEvents     GoalExecutionEvent[]

  @@unique([chainId, chainIndex])
  @@unique([id, projectId])
  @@unique([goalId, goalGeneration, goalIteration])
  @@unique([goalId, goalDispatchKey])
  @@unique([goalId, goalDecisionKey])
  @@unique([id, goalId, goalGeneration])
  @@unique([id, goalId, goalGeneration, goalIteration])
  @@index([projectId, status])
  @@index([assigneeAgentId])
  @@index([templateId])
  @@index([templateStepId])
  @@index([repoId])
  @@index([scheduleKind, status, runAt])
  @@index([projectId, archivedAt, status])
  @@index([recurringSourceTaskId])
  @@index([goalId, goalDispatchState])
  @@index([goalPredecessorTaskId])
}

/// Append-only ledger of trigger fires. Nothing reads it but the Triggers UI,
/// and the replay-window lookup keys off (templateId, dedupeKey, createdAt).
model TriggerFire {
  id         String            @id @default(cuid())
  templateId String
  chainId    String?
  source     TriggerFireSource
  dedupeKey  String?
  createdAt  DateTime          @default(now())
  template   TaskTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([templateId, dedupeKey, createdAt])
}

model TaskStepOutput {
  id        String   @id @default(cuid())
  taskId    String   @unique
  runId     String?
  kind      String
  body      String
  metadata  Json?
  commitSha String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([runId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorType String
  actorId   String?
  body      String
  metadata  Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Goal {
  id                 String               @id @default(cuid())
  projectId          String
  title              String
  spec               String
  dodApproved        Boolean              @default(false)
  status             GoalStatus           @default(PAUSED)
  spendCap           Decimal?             @db.Decimal(12, 2)
  spendUsd           Decimal              @default(0) @db.Decimal(12, 2)
  maxDurationMin     Int?                 @default(240)
  stallTimeoutMin    Int                  @default(10)
  maxSessionsPerTask Int                  @default(3)
  stuckThreshold     Int                  @default(19)
  runnerPreference   RunnerPreference     @default(AUTO)
  sharedFolderPath   String?
  goalGeneration     Int                  @default(1)
  nextGoalIteration  Int                  @default(1)
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definitionOfDone   GoalDefinitionItem[]
  progressLog        GoalProgressEntry[]
  sessions           Session[]
  runs               Run[]
  inboxMessages      InboxMessage[]
  inboxThreads       InboxThread[]
  tasks              Task[]
  executionEvents    GoalExecutionEvent[]

  @@unique([id, projectId])
  @@index([projectId, status])
}

model GoalDefinitionItem {
  id        String   @id @default(cuid())
  goalId    String
  itemIndex Int
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, itemIndex])
}

model GoalProgressEntry {
  id        String   @id @default(cuid())
  goalId    String
  sessionId String?
  body      String
  metadata  Json?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@index([sessionId])
}

model Run {
  id                    String               @id @default(cuid())
  projectId             String
  taskId                String?
  goalId                String?
  goalGeneration        Int?
  goalIteration         Int?
  /// The immediate source Run this Run retries. Null on a first Run. Unique, so a
  /// source Run can have at most one retry child — the database backstop behind
  /// the kernel's single-flight retry.
  retryOfRunId          String?              @unique
  agentId               String
  repoId                String?
  blockedByRunId        String?
  runNumber             Int
  dedupeKey             String               @unique
  status                RunStatus            @default(QUEUED)
  readyAt               DateTime             @default(now())
  runner                RunnerKind
  runnerId              String?
  leaseGeneration       Int                  @default(0)
  fencingToken          String?              @unique
  leaseExpiresAt        DateTime?
  heartbeatAt           DateTime?
  lastProcessAliveAt    DateTime?
  lastProgressEventAt   DateTime?
  inFlightTool          Json?
  sessionTokenHash      String?              @unique
  sessionTokenExpiresAt DateTime?
  sessionTokenRevokedAt DateTime?
  workspacePath         String?
  workspaceRetained     Boolean              @default(false)
  /// Control-plane *intent*, not an action: "the runner that owns this run's
  /// workspace root may reclaim its directory". The API publishes it and never
  /// deletes anything itself (issue #115); disposal belongs to the runner,
  /// which is the only process that owns the root it provisioned into.
  workspaceReclaimAt    DateTime?
  /// Set when the owning runner reports back what it did with the intent —
  /// removed or refused. A closed intent is never re-offered, and no later
  /// report may reopen it or change what it settled on.
  workspaceReclaimedAt  DateTime?
  /// Reclaim attempts that failed. It is what lets a failure report take the
  /// same compare-and-set as a closing one — a `FAILED` that arrives after the
  /// intent closed must not roll a succeeded cleanup back — and it is what an
  /// operator reads to find a workspace nobody can remove.
  workspaceReclaimAttempts Int               @default(0)
  /// The PR decision snapshotted when this run was created, so an operator's
  /// PATCH of the task cannot change a run already queued. The runner reads this
  /// and never the live task row.
  opensPullRequest      Boolean              @default(true)
  targetBranch          String?
  branch                String?
  /// The ref this run actually handed to `git push`, written only after the push
  /// returned. It is not the derived chain branch — `sharedChainBranch` remains
  /// the only thing that computes that — it is the record of what was published,
  /// and it is the only signal `resolveRunBranches` trusts as evidence that a
  /// chain branch exists on a remote. `branch` and `pushStatus` cannot answer
  /// that question: see the comment in workflow.ts.
  pushedBranch          String?
  baseSha               String?
  headSha               String?
  pushStatus            PushStatus           @default(NOT_REQUESTED)
  pushRemote            String?
  pushError             String?
  pullRequestUrl        String?
  pullRequestNumber     Int?
  deliveryInstructions  String?
  adapterVersion        String?
  cliVersion            String?
  model                 String
  authMode              String?
  manifest              Json?
  promptHash            String
  maxDurationMin        Int                  @default(240)
  stallTimeoutMin       Int                  @default(10)
  maxRunsPerTask        Int                  @default(5)
  // How many extra attempts this task has been *granted* on top of whatever
  // `Task.maxSessionsPerTask` says right now: one per attempt refunded as an
  // external failure, plus any a human re-authorized. `maxRunsPerTask` is the
  // absolute ceiling that answer produced, and it cannot be read back apart
  // from the configured budget of the moment it was written — which is why
  // lowering a task's budget used to leave the old, higher number in force.
  // Carried forward onto every run a task creates, so the newest row is the
  // running total.
  budgetGrants          Int                  @default(0)
  spendCap              Decimal?             @db.Decimal(12, 2)
  spendCapApplicable    Boolean              @default(false)
  failureClass          FailureClass?
  failureReason         String?
  retryable             Boolean?
  retryAt               DateTime?
  terminationReason     String?
  /// The structured account the runner gave of this failure: phase, exit facts,
  /// channel-separated evidence and typed timeout/transient markers. The API
  /// classifies from this and stores it verbatim, so a disputed verdict can be
  /// re-decided against what was actually observed instead of re-run. NULL on
  /// every successful run, and on every run reported by a runner too old to
  /// send one. See packages/db/src/failure-envelope.ts.
  failureEnvelope       Json?
  /// The raw tail of what this run produced: the agent's final output when it
  /// emitted one, otherwise the run's stdout, capped at 500k by the runner that
  /// sent it. Written on every completion a runner reports, succeeded or
  /// failed. Before this column the tail survived only when a *successful* run
  /// belonged to a template, chain or follow-up task, so the evidence of a
  /// failure — the case where it is worth the most — was discarded by the API
  /// that received it.
  ///
  /// Run telemetry, not a deliverable: it is never read into a downstream
  /// prompt, and it carries no "which run's output counts" semantics. That
  /// question belongs to TaskStepOutput (issue #121). Kept out of the run rows
  /// the task read routes serialize, because a task's five tails would dwarf
  /// everything else in the response.
  output                String?
  queuedAt              DateTime             @default(now())
  claimedAt             DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                  Task?                @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  goal                  Goal?                @relation(fields: [goalId, projectId], references: [id, projectId], onDelete: Restrict)
  agent                 Agent                @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Restrict)
  repo                  Repo?                @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Restrict)
  blockedBy             Run?                 @relation("RunDependency", fields: [blockedByRunId], references: [id], onDelete: SetNull)
  dependents            Run[]                @relation("RunDependency")
  session               Session?
  events                SessionEvent[]
  inboxDecisions        InboxDecision[]
  stepOutputs           TaskStepOutput[]
  retryOfRun            Run?                 @relation("RunRetryParent", fields: [retryOfRunId], references: [id], onDelete: Restrict)
  retryChildRun         Run?                 @relation("RunRetryParent")
  goalDecisionTasks     Task[]               @relation("TaskGoalDecisionRun")
  goalLineageTask       Task?                @relation("RunGoalLineageIdentity", fields: [taskId, goalId, goalGeneration, goalIteration], references: [id, goalId, goalGeneration, goalIteration], onDelete: Restrict)
  goalEventIdentities   GoalExecutionEvent[] @relation("GoalEventRunIdentity")
  goalExecutionEvents   GoalExecutionEvent[]

  @@unique([taskId, runNumber])
  @@unique([id, projectId])
  @@unique([id, goalId, goalGeneration, goalIteration])
  @@index([status, readyAt])
  @@index([status, leaseExpiresAt])
  @@index([projectId])
  @@index([agentId])
  @@index([repoId])
  @@index([blockedByRunId])
  @@index([goalId, goalGeneration, goalIteration])
  @@index([retryOfRunId])
}

model Session {
  id                     String                 @id @default(cuid())
  runId                  String                 @unique
  projectId              String
  agentId                String
  taskId                 String?
  goalId                 String?
  runner                 RunnerKind
  executionStatus        SessionExecutionStatus @default(REQUESTED)
  cleanupStatus          CleanupStatus          @default(PENDING)
  runtimeHandle          String?
  providerConversationId String?
  waitingOnMessageId     String?
  resumableUntil         DateTime?
  resumeAttempt          Int                    @default(0)
  resumeInput            String?
  maxDurationMin         Int                    @default(240)
  stallTimeoutMin        Int                    @default(10)
  requestedAt            DateTime               @default(now())
  provisionedAt          DateTime?
  startedAt              DateTime?
  endedAt                DateTime?
  cleanupStartedAt       DateTime?
  cleanupEndedAt         DateTime?
  exitCode               Int?
  signal                 String?
  terminationReason      String?
  costUsd                Decimal?               @db.Decimal(12, 4)
  inputTokens            Int?
  outputTokens           Int?
  cachedInputTokens      Int?
  totalTokens            Int? // input + output; cached excluded to avoid double counting
  failureReason          String?
  cleanupFailureReason   String?
  run                    Run                    @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Cascade)
  agent                  Agent                  @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Restrict)
  task                   Task?                  @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  goal                   Goal?                  @relation(fields: [goalId, projectId], references: [id, projectId], onDelete: Restrict)
  events                 SessionEvent[]
  inboxMessages          InboxMessage[]
  inboxThreads           InboxThread[]
  progressEntries        GoalProgressEntry[]

  @@unique([runId, projectId])
  @@index([executionStatus, requestedAt])
  @@index([cleanupStatus, requestedAt])
  @@index([projectId, requestedAt])
  @@index([agentId])
  @@index([taskId])
  @@index([goalId])
}

model SessionEvent {
  id              String             @id @default(cuid())
  sessionId       String
  runId           String
  seq             Int
  at              DateTime           @default(now())
  source          SessionEventSource
  type            String
  providerEventId String?
  toolCallId      String?
  payload         Json
  session         Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run             Run                @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([runId, at])
  @@index([runId, seq])
  @@index([sessionId, at])
}

model RunnerBackendState {
  runner                  RunnerKind @id
  cliVersion              String?
  authMode                String?
  capabilities            Json?
  lastPreflightAt         DateTime?
  lastPreflightOk         Boolean    @default(false)
  consecutiveAuthFailures Int        @default(0)
  circuitOpen             Boolean    @default(false)
  circuitReason           String?
  circuitOpenedAt         DateTime?
  updatedAt               DateTime   @updatedAt
}

model InboxMessage {
  id                String              @id @default(cuid())
  from              InboxSender
  agentId           String?
  sessionId         String?
  taskId            String?
  goalId            String?
  gateTaskId        String?
  threadId          String?
  replyToMessageId  String?
  kind              InboxKind           @default(TEXT)
  body              String
  choices           Json?
  selectedChoiceId  String?
  status            InboxStatus         @default(OPEN)
  channel           InboxChannel        @default(FEISHU)
  dedupeKey         String?             @unique
  externalMessageId String?             @unique
  externalActionId  String?             @unique
  deliveryStatus    InboxDeliveryStatus @default(PENDING)
  deliveryAttempts  Int                 @default(0)
  nextDeliveryAt    DateTime            @default(now())
  deliveredAt       DateTime?
  lastDeliveryError String?
  createdAt         DateTime            @default(now())
  answeredAt        DateTime?
  agent             Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  session           Session?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  task              Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal              Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  gateTask          Task?               @relation("InboxGateTask", fields: [gateTaskId], references: [id], onDelete: SetNull)
  thread            InboxThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  replyTo           InboxMessage?       @relation("InboxReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           InboxMessage[]      @relation("InboxReplies")
  decisions         InboxDecision[]

  @@index([status, createdAt])
  @@index([agentId])
  @@index([sessionId])
  @@index([taskId])
  @@index([goalId])
  @@index([gateTaskId, status])
  @@index([threadId, status, createdAt])
  @@index([deliveryStatus, nextDeliveryAt])
}

model InboxThread {
  id             String         @id @default(cuid())
  channel        InboxChannel   @default(FEISHU)
  externalChatId String
  sessionId      String?
  taskId         String?
  goalId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  session        Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal           Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  messages       InboxMessage[]

  @@unique([channel, externalChatId, sessionId])
  @@index([externalChatId])
  @@index([sessionId])
}

model InboxExternalEvent {
  id              String       @id @default(cuid())
  channel         InboxChannel @default(FEISHU)
  externalEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime     @default(now())
  processedAt     DateTime?
  processingError String?

  @@unique([channel, externalEventId])
  @@index([processedAt, receivedAt])
}

model InboxDecision {
  id              String       @id @default(cuid())
  inboxMessageId  String
  runId           String
  externalEventId String       @unique
  decision        String
  actorOpenId     String?
  createdAt       DateTime     @default(now())
  inboxMessage    InboxMessage @relation(fields: [inboxMessageId], references: [id], onDelete: Cascade)
  run             Run          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([inboxMessageId])
  @@index([runId])
}

/// Durable, append-only evidence of every Goal execution transition. One row per
/// committed non-no-op transition, except restart, which writes exactly two.
model GoalExecutionEvent {
  id             String   @id @default(cuid())
  goalId         String
  goalGeneration Int
  goalIteration  Int?
  taskId         String?
  runId          String?
  type           String
  dedupeKey      String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Restrict)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  run            Run?     @relation(fields: [runId], references: [id], onDelete: Restrict)
  taskIdentity   Task?    @relation("GoalEventTaskIdentity", fields: [taskId, goalId, goalGeneration, goalIteration], references: [id, goalId, goalGeneration, goalIteration], onDelete: Restrict)
  runIdentity    Run?     @relation("GoalEventRunIdentity", fields: [runId, goalId, goalGeneration, goalIteration], references: [id, goalId, goalGeneration, goalIteration], onDelete: Restrict)

  @@index([goalId, createdAt])
  @@index([goalId, goalGeneration, goalIteration])
  @@index([taskId])
  @@index([runId])
}
