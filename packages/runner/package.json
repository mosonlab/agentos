{
  "name": "@anneal/runner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapters": {
      "types": "./src/adapters.ts",
      "import": "./dist/adapters.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./dist/api.js"
    },
    "./reclaim": {
      "types": "./src/reclaim.ts",
      "import": "./dist/reclaim.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../build-info/stamp.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @anneal/github-client",
    "test": "node --import tsx --test src/*.test.ts src/adapters/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anneal/build-info": "0.3.0",
    "@anneal/db": "0.3.0",
    "@anneal/github-client": "0.3.0",
    "dotenv": "^17.2.3",
    "fs-ext": "^2.1.1"
  },
  "devDependencies": {
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
