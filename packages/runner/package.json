{
  "name": "@agentos/runner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    "./reclaim": {
      "types": "./src/reclaim.ts",
      "import": "./dist/reclaim.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../build-info/stamp.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @agentos/github-client",
    "test": "node --import tsx --test src/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentos/build-info": "0.3.0",
    "@agentos/db": "0.3.0",
    "@agentos/github-client": "0.3.0",
    "dotenv": "^17.2.3",
    "fs-ext": "^2.1.1"
  },
  "devDependencies": {
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
