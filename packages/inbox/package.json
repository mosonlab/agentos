{
  "name": "@agentos/inbox",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @agentos/db",
    "test": "node --import tsx --test src/*.test.ts ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY}",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentos/db": "0.3.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
