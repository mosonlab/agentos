{
  "name": "@anneal/inbox",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash ../../scripts/host-proof-slot.sh build @anneal/inbox -- tsc -p tsconfig.json",
    "typecheck": "bash ../../scripts/host-proof-slot.sh typecheck @anneal/inbox -- tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @anneal/db",
    "test": "bash ../../scripts/host-proof-slot.sh test @anneal/inbox -- node --import tsx --test src/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anneal/db": "0.6.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
