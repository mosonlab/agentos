{
  "name": "agentos",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=10.9.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @agentos/github-client && npm run build -w @agentos/db && npm run build -w @agentos/api && npm run build -w @agentos/runner && npm run build -w @agentos/inbox && npm run build -w @agentos/merge-executor && npm run build -w @agentos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:cli": "npm run typecheck:cli -w @agentos/db",
    "lint": "npm run lint:biome && npm run lint:types",
    "lint:biome": "biome lint",
    "lint:types": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "setup:local": "node scripts/setup-local.mjs",
    "test:setup-local": "node --test scripts/setup-local.test.mjs",
    "verify:secret-hygiene": "node scripts/verify-secret-hygiene.mjs",
    "test:secret-hygiene": "node --test scripts/verify-secret-hygiene.test.mjs",
    "test:merge-executor-setup": "node --test scripts/setup-merge-executor.test.mjs",
    "verify:oss-b0": "node scripts/verify-oss-b0.mjs",
    "test:oss-b0-harness": "node --test scripts/verify-oss-b0.test.mjs",
    "verify:compose-binding": "node scripts/compose-binding.mjs",
    "test:compose-binding": "node --test scripts/compose-binding.test.mjs",
    "test:frozen-docs": "node --test scripts/check-frozen-docs.test.mjs",
    "test:gate-worker": "node --test scripts/gate-worker/gate-env.test.mjs scripts/gate-worker/gate-worker.test.mjs scripts/gate-worker/gate-dispatch.test.mjs",
    "test:auto-deploy": "node --test scripts/deploy/quiet-window-deploy.test.mjs",
    "snapshot:authority": "npm run snapshot:authority -w @agentos/db",
    "snapshot:authority-keygen": "npm run snapshot:authority-keygen -w @agentos/db --",
    "snapshot:scan": "node scripts/public-snapshot-scan.mjs",
    "test:snapshot-scan": "node --test scripts/public-snapshot-scan.test.mjs",
    "test:release-docs": "node --test scripts/release-docs.test.mjs scripts/setup-merge-executor.test.mjs",
    "demo:templates": "node scripts/templates-release-demo.mjs",
    "test:demo-templates": "node --test scripts/templates-release-demo.test.mjs",
    "test:dependency-gate": "node --test scripts/goal-5a0-dependency-gate.test.mjs scripts/goal-5a0-handoff-preimage.test.mjs",
    "test:db": "npm run test:db -w @agentos/api",
    "merge-gate": "bash scripts/merge-gate.sh",
    "verify:build-sha": "node packages/build-info/verify-dist.mjs",
    "dev:api": "npm run dev -w @agentos/api",
    "dev:web": "npm run dev -w @agentos/web",
    "dev:runner": "npm run dev -w @agentos/runner",
    "dev:inbox": "npm run dev -w @agentos/inbox",
    "db:generate": "npm run db:generate -w @agentos/db",
    "db:migrate": "npm run db:migrate -w @agentos/db",
    "db:migrate:release": "npm run db:migrate:release -w @agentos/db --",
    "db:migrate-status": "npm run db:migrate-status -w @agentos/db",
    "db:drift-check": "npm run db:drift-check -w @agentos/db",
    "db:seed": "npm run db:seed -w @agentos/db",
    "db:sync-canonical-prompts": "npm run db:sync-canonical-prompts -w @agentos/db",
    "db:verify-agent-template": "npm run db:verify-agent-template -w @agentos/db",
    "db:validate": "npm run db:validate -w @agentos/db",
    "db:preflight-goal-execution": "npm run db:preflight-goal-execution -w @agentos/db",
    "db:files-precheck": "npm run db:files-precheck -w @agentos/db",
    "db:migrate-goal-execution": "npm run db:migrate-goal-execution -w @agentos/db",
    "db:verify-goal-execution": "npm run db:verify-goal-execution -w @agentos/db",
    "db:verify-starter-onboarding": "npm run db:verify-starter-onboarding -w @agentos/db",
    "db:export-goal-lineage": "npm run db:export-goal-lineage -w @agentos/db",
    "db:backfill-session-usage": "npm run db:backfill-session-usage -w @agentos/db",
    "db:backfill-task-source": "npm run db:backfill-task-source -w @agentos/db",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "eslint": "10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "allowScripts": {
    "fs-ext@2.1.1": true
  }
}
